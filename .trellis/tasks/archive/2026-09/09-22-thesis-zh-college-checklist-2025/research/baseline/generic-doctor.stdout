  "items": [
    {
      "id": "GEN-01",
      "requirement": "题名简明反映最重要的特定内容，不超过 20 字（国标值，各校可能放宽，以本校规范为准）；避免不常用缩略词、首字母缩写字、字符、代号和公式",
      "basis": "§5.1.1.2",
      "method": "script:title_len",
      "scope": "通用",
      "status": "PASS",
      "evidence": "题名 13 字: 面向虚构场景的占位研究方法"
    },
    {
      "id": "GEN-02",
      "requirement": "题名在论文各处出现时完全相同；基金资助项目将基金注释在题名所在页地脚",
      "basis": "§5.1.1.2",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
    },
    {
      "id": "GEN-03",
      "requirement": "应有中文摘要，为了国际交流还应有外文（多用英文）摘要；中文在前、英文在后为校级惯例",
      "basis": "§5.1.5.2 + 校级惯例",
      "method": "script:abstract_order",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "未找到英文摘要环境，请人工核对中前英后与内容一致性"
    },
    {
      "id": "GEN-04",
      "requirement": "摘要独立自含：说明研究目的、实验方法、结果和最终结论，重点是结果和结论",
      "basis": "§5.1.5.3",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
    },
    {
      "id": "GEN-05",
      "requirement": "摘要字数国标值：中文一般不宜超过 200～300 字、外文不宜超过 250 个实词（特殊需要可略多）；各校学位论文普遍另有更高字数要求，以本校规范为准（脚本仅报实测字数，不设阈值）",
      "basis": "§5.1.5.4",
      "method": "script:abstract_len",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "摘要实测约 90 字；当前模板无字数阈值依据，请对照本校规范判断"
    },
    {
      "id": "GEN-06",
      "requirement": "摘要中不用图、表、化学结构式、非公知公用的符号和术语（除非实在无变通办法）；不标注引用文献编号为校级惯例",
      "basis": "§5.1.5.5 + 校级惯例",
      "method": "script:abstract_no_cite",
      "scope": "通用",
      "status": "PASS",
      "evidence": "摘要未见引用编号/图表/公式环境"
    },
    {
      "id": "GEN-07",
      "requirement": "关键词 3～8 个，用显著的字符另起一行排在摘要左下方，尽量采用《汉语主题词表》等规范词（各校可能收紧个数；国标未规定分隔符）",
      "basis": "§5.1.6",
      "method": "script:kw_count",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "未找到中文关键词（可能使用封面自定义宏），请人工核对 3~8 个"
    },
    {
      "id": "GEN-08",
      "requirement": "摘要、关键词、分类号和目次页均应有与中文对应的英文译文",
