      "scope": "通用",
      "status": "MODULE",
      "evidence": "由 consistency 模块覆盖: uv run python $SKILL_DIR/scripts/check_consistency.py main.tex --terms"
    },
    {
      "id": "GEN-13",
      "requirement": "引言简要说明研究目的、范围、前人工作与知识空白、理论基础、研究方法等；言简意赅、不与摘要雷同、不成为摘要的注释；教科书知识不赘述（综述与理论分析可单独成章）",
      "basis": "§5.2.1",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
    },
    {
      "id": "GEN-14",
      "requirement": "图表编号国标为全篇连续（\"图1\"\"图2\"，连续到附录之前、与章条编号无关，仅一幅图也标\"图1\"）；各校普遍改按章编号（\"图 2.1\"/\"图 3-1\"），以本校规范为准并全文统一",
      "basis": "§5.2.3 §5.2.4 + 校级惯例",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
    },
    {
      "id": "GEN-15",
      "requirement": "图应有编号和图题，置图下方居中；表编号和表题置表上方居中；曲线图坐标须标注量、标准规定符号、单位",
      "basis": "§5.2.3 §5.2.4",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
    },
    {
