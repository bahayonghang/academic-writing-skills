{# defense.typ skeleton for the academic-defense-beamer Touying backend. build_deck.py renders #}
{# every value as a Typst expression (string literals for plan text); this template adds no #}
{# escaping and defines no functions. Layouts: references/touying-backend.md. #}
// defense.typ: generated by academic-defense-beamer scripts/build_deck.py.
// Edit slide_plan.yaml and run build_deck.py again. Do not edit this file by hand.
#import "{{ package }}": *
#import "@preview/mitex:0.2.6": mitex, mi
{% if macros %}

// Thesis preamble macros that the selected equations, tables, and captions use.
#let thesis-macros = {{ macros }}.text
{% endif %}

#show: ysu-theme.with(
  aspect-ratio: "16-9",
  notes: sys.inputs.at("notes", default: "off") == "on",
  nav-labels: {{ nav_labels }},
  config-info(
    title: {{ title }},
    author: {{ author }},
    supervisor: {{ supervisor }},
    subject: {{ subject }},
    school: {{ school }},
    date: {{ date }},
    stage: {{ stage }},
    stage-en: {{ stage_en }},
  ),
)
{% for frame in frames %}
{% for heading in frame.skip_headings %}

= #{{ heading }} <touying:skip>
{% endfor %}

// defense-frame: id={{ frame.id }} role={{ frame.role }} chapter={{ frame.chapter }} layout={{ frame.layout }}
{% include "frames/" ~ frame.layout ~ ".typ.j2" %}
{% endfor %}
