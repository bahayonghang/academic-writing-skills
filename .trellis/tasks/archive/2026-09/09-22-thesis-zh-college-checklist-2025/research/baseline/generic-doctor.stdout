    {
      "id": "GEN-17",
      "requirement": "结论准确、完整、明确、精练，是最终的总体结论、非各段小结的简单重复；不可能导出结论时可只作必要讨论；可提出建议、研究设想、尚待解决的问题等",
      "basis": "§5.2.5",
      "method": "llm",
      "scope": "通用",
      "status": "NEEDS-LLM",
      "evidence": "由 agent 对照正文与规范依据逐项判读"
