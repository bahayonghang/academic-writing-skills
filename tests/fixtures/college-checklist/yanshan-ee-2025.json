  },
  {
    "id": "YSE-086",
    "source_line": 597,
    "requirement": "除绪论外，论文主体各章首段为总述，内容简明扼要，主要论述本章核心研究内容以及为何要做本章相关研究。；最后一节为「本章小结」，对本章研究内容、方法与成果作简要总结与概括（实验方法或材料等章除外）。",
    "basis": "学院2025清单第86项",
    "method": "llm",
    "scope": "通用",
    "status": {
      "doctor": "NEEDS-LLM",
      "master": "NEEDS-LLM"
    }
  },
  {
