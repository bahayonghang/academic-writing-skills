% defense-layouts.sty
% Shared layout macros for the academic-defense-beamer Beamer themes.
% beamerthemeYanshanDefense.sty and beamerthemeGenericDefense.sty load this package.
% Layout names, fields, and limits: references/slide-layouts.md.
% Colors, positions, and font sizes: references/visual-spec.md.
% Part of academic-writing-skills (academic-defense-beamer). PolyForm Noncommercial 1.0.0, not for commercial use.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{defense-layouts}[2026/11/21 v6.0.0 academic-defense-beamer layout macros]

\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc,shapes.geometric,arrows.meta,backgrounds}
\RequirePackage{adjustbox}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{makecell}

% ---------------------------------------------------------------------------
% Colors. These are neutral defaults. Each theme redefines all nine names.
% ---------------------------------------------------------------------------
\definecolor{defenseNavy}{HTML}{1F3A5F}
\definecolor{defenseBlue}{HTML}{2E5E8C}
\definecolor{defenseAccent}{HTML}{2E5E8C}
\definecolor{defenseBoxHead}{HTML}{1F3A5F}
\definecolor{defensePaper}{HTML}{182D4A}
\definecolor{defenseRed}{HTML}{A93226}
\definecolor{defenseTint}{HTML}{F4F6F9}
\definecolor{defenseLine}{HTML}{D5DCE4}
\definecolor{defenseMuted}{HTML}{5D6773}
\setbeamercolor{defense toc current}{fg=defenseNavy}

% ---------------------------------------------------------------------------
% Fonts. CJK: Microsoft YaHei -> Source Han Sans SC -> FandolHei.
% Latin: Arial -> TeX Gyre Heros.
% ---------------------------------------------------------------------------
\IfFontExistsTF{Microsoft YaHei}
  {\setCJKsansfont{Microsoft YaHei}[BoldFont=* Bold]}
  {\IfFontExistsTF{Source Han Sans SC}
    {\setCJKsansfont{Source Han Sans SC}[BoldFont=* Bold]}
    {\setCJKsansfont{FandolHei-Regular.otf}[BoldFont=FandolHei-Bold.otf]}}
\IfFontExistsTF{Arial}
  {\setsansfont{Arial}}
  {\setsansfont{texgyreheros}[Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,
    ItalicFont=*-italic,BoldItalicFont=*-bolditalic]}

% ---------------------------------------------------------------------------
% Frame defaults: top alignment, \small body text, restrained academic ink.
% ---------------------------------------------------------------------------
\beamer@centeredfalse
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{\vbox to 0.3cm{}}
\setbeamertemplate{frame begin}{\small}
\setbeamercolor{normal text}{fg=black!88!defenseNavy}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamercolor{frametitle}{fg=defenseNavy}
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.55ex]\fill[defenseAccent,rounded corners=0.8pt] (0,0) rectangle (0.14cm,0.14cm);}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.45ex]\fill[defenseMuted,rounded corners=0.6pt] (0,0) rectangle (0.11cm,0.11cm);}
\setbeamercolor{itemize item}{fg=defenseAccent}
\setbeamercolor{itemize subitem}{fg=defenseMuted}

% ---------------------------------------------------------------------------
% Settings, metadata, chapter list, and label map.
% ---------------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \g__defense_logo_tl
\tl_new:N \g__defense_logo_text_tl
\tl_new:N \g__defense_stage_tl
\tl_gset:Nn \g__defense_stage_tl { predefense }
\tl_new:N \g__defense_supervisor_tl
\tl_new:N \g__defense_subject_tl
\tl_new:N \g__defense_school_tl
\seq_new:N \g__defense_chapter_seq
\prop_new:N \g__defense_label_prop

\keys_define:nn { defense }
  {
    logo .tl_gset:N = \g__defense_logo_tl ,
    logo-text .tl_gset:N = \g__defense_logo_text_tl ,
    stage .choices:nn = { predefense , defense }
      { \tl_gset_eq:NN \g__defense_stage_tl \l_keys_choice_tl } ,
  }

\NewDocumentCommand \DefenseSetup { m } { \keys_set:nn { defense } {#1} }
\NewDocumentCommand \DefenseStage { m } { \keys_set:nn { defense } { stage = #1 } }
\NewDocumentCommand \DefenseSupervisor { m } { \tl_gset:Nn \g__defense_supervisor_tl {#1} }
\NewDocumentCommand \DefenseSubject { m } { \tl_gset:Nn \g__defense_subject_tl {#1} }
\NewDocumentCommand \DefenseSchool { m } { \tl_gset:Nn \g__defense_school_tl {#1} }
\NewDocumentCommand \DefenseAddChapter { m m }
  { \seq_gput_right:Nn \g__defense_chapter_seq { {#1} {#2} } }
\NewDocumentCommand \DefenseDefineLabel { m m }
  { \prop_gput:Nnn \g__defense_label_prop {#1} {#2} }

\cs_new:Npn \defense@supervisor { \g__defense_supervisor_tl }
\cs_new:Npn \defense@subject { \g__defense_subject_tl }
\cs_new:Npn \defense@school { \g__defense_school_tl }
\cs_new:Npn \defense@stagetext
  {
    \str_if_eq:VnTF \g__defense_stage_tl { defense }
      { 博士学位论文答辩 } { 博士学位论文预答辩 }
  }

% DefenseSource: inside the group, \ref and \eqref print the thesis number that
% \DefenseDefineLabel maps (?? when the label has no mapping), and the citation
% commands print nothing. Outside the group, all commands keep their meaning.
\cs_new:Npn \__defense_label_number:n #1
  {
    \prop_if_in:NnTF \g__defense_label_prop {#1}
      { \prop_item:Nn \g__defense_label_prop {#1} } { ?? }
  }
\NewDocumentEnvironment { DefenseSource } { }
  {
    \DeclareDocumentCommand \ref { s m } { \__defense_label_number:n {##2} }
    \DeclareDocumentCommand \eqref { s m } { ( \__defense_label_number:n {##2} ) }
    \clist_map_inline:nn { cite , citep , citet , upcite , parencite , textcite }
      { \exp_args:Nc \DeclareDocumentCommand {##1} { s o o m } { } }
  }
  { }

% Logo slot. A theme selects the "defense logo" template: [image] or [empty].
% [image] shows the logo file when it exists; otherwise it shows logo-text.
\dim_new:N \l__defense_logo_height_dim
\tl_new:N \l__defense_logo_font_tl
\cs_new_protected:Npn \defense@logo #1#2
  {
    \group_begin:
      \dim_set:Nn \l__defense_logo_height_dim {#1}
      \tl_set:Nn \l__defense_logo_font_tl {#2}
      \usebeamertemplate { defense~logo }
    \group_end:
  }
\cs_new_protected:Npn \__defense_logo_text:
  {
    \tl_if_blank:VF \g__defense_logo_text_tl
      {
        \group_begin:
          \l__defense_logo_font_tl \bfseries \color { defenseNavy }
          \g__defense_logo_text_tl
        \group_end:
      }
  }
\cs_new_protected:Npn \defense@logo@image
  {
    \tl_if_blank:VTF \g__defense_logo_tl
      { \__defense_logo_text: }
      {
        \IfFileExists { \g__defense_logo_tl }
          { \includegraphics [ height = \l__defense_logo_height_dim ] { \g__defense_logo_tl } }
          { \__defense_logo_text: }
      }
  }

% Table of contents lines. Line pitch is min(0.95 cm, 6.6 cm / chapter count).
% \defense@tocmeasure runs outside the tikzpicture: TikZ uses \nullfont inside.
\int_new:N \l__defense_toc_count_int
\int_new:N \l__defense_toc_index_int
\dim_new:N \l__defense_toc_step_dim
\dim_new:N \l__defense_toc_width_dim
\dim_new:N \l__defense_toc_top_dim
\box_new:N \l__defense_toc_box
\cs_new:Npn \__defense_toc_num:n #1
  { \int_compare:nNnTF {#1} < {10} { 0#1 } {#1} }
\cs_new:Npn \__defense_toc_text:nn #1#2 { 第 #1 章 \quad #2 }
\cs_new_protected:Npn \__defense_toc_line:nnnn #1#2#3#4
  {
    \str_if_eq:nnTF {#1} {#3}
      {
        \defense@toclinecurrent
          { \dim_eval:n { 0.5\paperwidth - 0.5\l__defense_toc_width_dim - 0.55cm } }
          { \dim_eval:n { \l__defense_toc_top_dim + \l__defense_toc_step_dim * ( #2 - 1 ) } }
          { \dim_eval:n { \l__defense_toc_width_dim + 1.1cm } }
          { \__defense_toc_num:n {#3} }
          { \__defense_toc_text:nn {#3} {#4} }
      }
      {
        \defense@toclinenormal
          { \dim_eval:n { 0.5\paperwidth - 0.5\l__defense_toc_width_dim - 0.55cm } }
          { \dim_eval:n { \l__defense_toc_top_dim + \l__defense_toc_step_dim * ( #2 - 1 ) } }
          { \__defense_toc_num:n {#3} }
          { \__defense_toc_text:nn {#3} {#4} }
      }
  }
\cs_new_protected:Npn \defense@tocmeasure
  {
    \int_set:Nn \l__defense_toc_count_int { \seq_count:N \g__defense_chapter_seq }
    \dim_zero:N \l__defense_toc_width_dim
    \int_compare:nNnT { \l__defense_toc_count_int } > { 0 }
      {
        \dim_set:Nn \l__defense_toc_step_dim
          { \dim_min:nn { 0.95cm } { 6.6cm / \l__defense_toc_count_int } }
        \seq_map_inline:Nn \g__defense_chapter_seq
          {
            \hbox_set:Nn \l__defense_toc_box
              { \normalsize \bfseries \__defense_toc_text:nn ##1 }
            \dim_set:Nn \l__defense_toc_width_dim
              { \dim_max:nn { \l__defense_toc_width_dim } { \box_wd:N \l__defense_toc_box } }
          }
        \dim_set:Nn \l__defense_toc_top_dim
          {
            2.05cm + ( 6.4cm - \l__defense_toc_step_dim
              * ( \l__defense_toc_count_int - 1 ) ) / 2
          }
      }
  }
\cs_new_protected:Npn \defense@toclines #1
  {
    \int_zero:N \l__defense_toc_index_int
    \seq_map_inline:Nn \g__defense_chapter_seq
      {
        \int_incr:N \l__defense_toc_index_int
        \__defense_toc_line:nnnn {#1} { \int_use:N \l__defense_toc_index_int } ##1
      }
  }
\ExplSyntaxOff

\newcommand\defense@toclinenormal[4]{%
  \node[fill=defenseTint,draw=defenseLine,line width=0.4pt,rounded corners=2pt,
    minimum width=0.68cm,minimum height=0.46cm,inner sep=0pt,
    text=defenseMuted,font=\footnotesize\bfseries,anchor=west] at (#1,-#2) {#3};
  \node[anchor=west,inner sep=0pt,text=black!82!defenseNavy,font=\normalsize]
    at (\dimexpr#1+0.88cm\relax,-#2) {#4};}

\newcommand\defense@toclinecurrent[5]{%
  \fill[defenseTint,rounded corners=3pt]
    (\dimexpr#1-0.14cm\relax,\dimexpr-#2+0.34cm\relax)
    rectangle (\dimexpr#1+#3+0.35cm\relax,\dimexpr-#2-0.34cm\relax);
  \fill[defenseRed]
    (\dimexpr#1-0.14cm\relax,\dimexpr-#2+0.34cm\relax)
    rectangle (\dimexpr#1-0.06cm\relax,\dimexpr-#2-0.34cm\relax);
  \node[fill=defenseNavy,rounded corners=2pt,minimum width=0.68cm,minimum height=0.46cm,
    inner sep=0pt,text=white,font=\footnotesize\bfseries,anchor=west] at (#1,-#2) {#4};
  \node[anchor=west,inner sep=0pt,font=\normalsize\bfseries]
    at (\dimexpr#1+0.88cm\relax,-#2) {\usebeamercolor[fg]{defense toc current}#5};}

% ---------------------------------------------------------------------------
% Beamer templates that the themes select.
% ---------------------------------------------------------------------------
\defbeamertemplate{defense logo}{image}{\defense@logo@image}
\defbeamertemplate{defense logo}{empty}{}
\setbeamertemplate{defense logo}[image]

% Modern academic content header: left-aligned navy title on the 1 cm margin grid,
% hairline divider with a short brick-red anchor bar, right-hand logo and page badge.
\defbeamertemplate{frametitle}{defense}{%
  \nointerlineskip
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\textwidth,-0.80cm);
    \begin{scope}[shift={(-\beamer@leftmargin,0pt)}]
      \node[anchor=west,inner sep=0pt,font=\usebeamerfont{frametitle}]
        at (1.0cm,-0.42cm) {\usebeamercolor[fg]{frametitle}\insertframetitle};
      \draw[defenseLine,line width=0.5pt] (1.0cm,-0.77cm) -- (15.0cm,-0.77cm);
      \fill[defenseRed] (1.0cm,-0.755cm) rectangle (1.95cm,-0.795cm);
      \node[anchor=east,inner sep=0pt] at (14.12cm,-0.42cm)
        {\defense@logo{0.52cm}{\small}};
      \shade[left color=defenseNavy,right color=defenseBlue]
        (14.42cm,-0.21cm) -- (15.00cm,-0.21cm) -- (14.88cm,-0.63cm) -- (14.30cm,-0.63cm) -- cycle;
      \node[text=white,font=\scriptsize\bfseries] at (14.65cm,-0.42cm) {\insertframenumber};
    \end{scope}
  \end{tikzpicture}%
}

% ---------------------------------------------------------------------------
% Whole-frame layouts: architectural cover, TOC, and closing slide.
% ---------------------------------------------------------------------------
\newcommand\defense@infotable{%
  \renewcommand\arraystretch{1.18}%
  \begin{tabular}{@{}r@{\hspace{0.3em}}l@{\hspace{1.8em}}r@{\hspace{0.3em}}l@{}}
    {\color{defenseTint!85!white}专\quad 业：}& {\color{white}\bfseries\defense@subject} &
    {\color{defenseTint!85!white}导\quad 师：}& {\color{white}\bfseries\defense@supervisor}\\
    {\color{defenseTint!85!white}学\quad 院：}& {\color{white}\bfseries\defense@school} &
    {\color{defenseTint!85!white}日\quad 期：}& {\color{white}\bfseries\insertdate}
  \end{tabular}}

% #1 central plaque text, #2 straddling capsule text.
\newcommand\defense@titlepage[2]{%
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={(current page.north west)}]
      \fill[defenseTint!55!white] (0,0) rectangle (\paperwidth,-5.75cm);
      \node[anchor=north west,inner sep=0pt] at (1.0cm,-0.48cm) {\defense@logo{0.92cm}{\large}};
      \node[anchor=east,fill=defenseTint,draw=defenseLine,line width=0.5pt,rounded corners=3pt,
        inner xsep=8pt,inner ysep=3.5pt,text=defenseNavy,font=\small\bfseries]
        at (15.0cm,-0.92cm) {\defense@stagetext};
      % Subtle shadow + crisp white title plaque
      \fill[defenseLine!65!white,rounded corners=4pt] (1.06cm,-1.76cm) rectangle (15.06cm,-5.06cm);
      \fill[white,draw=defenseLine,line width=0.5pt,rounded corners=4pt]
        (1.0cm,-1.70cm) rectangle (15.0cm,-5.00cm);
      \fill[defenseNavy] (1.0cm,-1.70cm) rectangle (15.0cm,-1.80cm);
      \fill[defenseRed] (1.0cm,-1.70cm) rectangle (3.2cm,-1.80cm);
      \node[text=defenseNavy,font=\huge\bfseries,align=flush center,text width=13.0cm]
        at (0.5\paperwidth,-3.40cm) {#1};
      % Deep navy architectural plinth
      \shade[left color=defenseNavy,right color=defensePaper]
        (0,-5.75cm) rectangle (\paperwidth,-\paperheight);
      \fill[defenseAccent] (0,-5.75cm) rectangle (\paperwidth,-5.82cm);
      % Straddling speaker capsule
      \node[fill=white,draw=defenseNavy,line width=0.8pt,rounded corners=10pt,
        inner xsep=14pt,inner ysep=4pt,text=defenseNavy,font=\normalsize\bfseries]
        at (0.5\paperwidth,-5.75cm) {#2};
      \node[anchor=north,inner sep=0pt,font=\small] at (0.5\paperwidth,-6.62cm)
        {\defense@infotable};
    \end{scope}
  \end{tikzpicture}}

\newcommand\DefenseCoverFrame{\defense@titlepage{\inserttitle}{汇报人：\insertauthor}}
\newcommand\DefenseThanksFrame{\defense@titlepage{敬请各位老师批评和指正！}{汇报人：\insertauthor}}

% #1 current chapter number; 0 highlights no line.
\newcommand\DefenseTocFrame[1]{%
  \defense@tocmeasure
  \begin{tikzpicture}[remember picture,overlay]
    \begin{scope}[shift={(current page.north west)}]
      \fill[defenseNavy] (0,0) rectangle (0.32cm,-\paperheight);
      \node[anchor=west,inner sep=0pt,text=defenseNavy,font=\Huge\bfseries]
        at (1.2cm,-0.92cm) {目\enspace 录};
      \node[anchor=west,inner sep=0pt,text=defenseMuted,font=\footnotesize\bfseries]
        at (3.55cm,-0.98cm) {CONTENTS};
      \draw[defenseLine,line width=0.6pt] (1.2cm,-1.42cm) -- (15.0cm,-1.42cm);
      \fill[defenseRed] (1.2cm,-1.40cm) rectangle (2.4cm,-1.46cm);
      \defense@toclines{#1}
    \end{scope}
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% Content macros: hierarchy, emphasis, structured containers, KPI, and notes.
% ---------------------------------------------------------------------------
\newcommand\DefenseSubsection[1]{%
  \par\noindent
  \begin{tikzpicture}[baseline=(defense-sub.base)]
    \fill[defenseAccent,rounded corners=1.2pt] (0,-0.06cm) rectangle (0.12cm,0.30cm);
    \node[anchor=west,inner sep=0pt,text=defenseNavy,font=\normalsize\bfseries] (defense-sub)
      at (0.24cm,0) {#1};
  \end{tikzpicture}\par\vspace{0.10cm}}

% Conclusion banner at the bottom of the frame: tint surface + left semantic accent bar.
\newcommand\DefenseTakeaway[1]{%
  \par\vspace{0pt plus 1filll}\noindent
  \begin{tikzpicture}
    \node[fill=defenseTint,draw=defenseLine,line width=0.5pt,rounded corners=2.5pt,
      inner xsep=8pt,inner ysep=3.5pt,text width=\linewidth-16pt-0.5pt,
      align=flush center,text=defenseNavy,font=\small\bfseries] (defense-take) {#1};
    \fill[defenseRed,rounded corners=1pt]
      (defense-take.north west) rectangle ([xshift=2.6pt]defense-take.south west);
  \end{tikzpicture}\par}

% Brick-red key emphasis (**...**, at most 3 per slide) and navy structural term (*...*).
\newcommand\DefenseHighlight[1]{\textcolor{defenseRed}{\textbf{#1}}}
\newcommand\DefenseTerm[1]{\textcolor{defenseNavy}{\textbf{#1}}}

% Inline dimension tag for "短签｜核心短句" micro-typography.
\newcommand\DefenseLead[1]{%
  \tikz[baseline=(defense-lead.base)]\node[fill=defenseTint,draw=defenseLine,line width=0.4pt,
    rounded corners=2pt,inner xsep=4pt,inner ysep=1.5pt,text=defenseNavy,
    font=\footnotesize\bfseries] (defense-lead) {#1};\hspace{0.35em}\ignorespaces}

\newcommand\DefenseBoxTitle[1]{%
  \tikz[baseline=(defense-box.base)]\node[fill=defenseBoxHead,text=white,font=\footnotesize\bfseries,
    rounded corners=2pt,inner xsep=5.5pt,inner ysep=2.5pt] (defense-box) {#1};}

\newcommand\DefenseCaption[1]{%
  \par\vspace{2pt}{\centering\footnotesize\color{defenseMuted}#1\par}}

% #1 extra \includegraphics options, #2 file, #3 caption with the thesis number.
\NewDocumentCommand\DefenseFigure{O{}mm}{%
  \par{\centering
    \begingroup\setlength{\fboxsep}{1.5pt}\setlength{\fboxrule}{0.4pt}%
    \fcolorbox{defenseLine}{white}{%
      \includegraphics[width=\dimexpr\linewidth-3.8pt\relax,height=0.59\textheight,keepaspectratio,#1]{#2}}%
    \endgroup\par}%
  \DefenseCaption{#3}}

% Publication box: solid navy label on the left, tinted bibliographic card on the right.
\newcommand\DefensePaperBox[1]{%
  \par\vspace{0.15cm}\noindent
  \begin{tikzpicture}
    \node[anchor=north west,inner xsep=6pt,inner ysep=4pt,
      text width=\linewidth-1.25cm-12pt-1.2pt,align=left,text=black!86!defenseNavy,
      font=\footnotesize] (defense-paper) at (1.25cm,0) {#1};
    \node[text=white,font=\footnotesize\bfseries] at (0.625cm,0 |- defense-paper.west) {论文};
    \begin{scope}[on background layer]
      \clip[rounded corners=2.5pt] (0,0) rectangle (defense-paper.south east);
      \fill[defenseTint] (0,0) rectangle (defense-paper.south east);
      \fill[defensePaper] (0,0) rectangle (1.25cm,0 |- defense-paper.south);
    \end{scope}
    \draw[defenseLine,line width=0.5pt,rounded corners=2.5pt]
      (0,0) rectangle (defense-paper.south east);
  \end{tikzpicture}\par}

% Single-column side card: solid header badge beside a left-accented tint panel.
\newcommand\DefenseCard[2]{%
  \par\noindent
  \begin{tikzpicture}
    \node[anchor=west,fill=defenseTint,draw=defenseLine,line width=0.4pt,rounded corners=2.5pt,
      inner xsep=7pt,inner ysep=3.8pt,text width=\linewidth-2.25cm-14pt-0.8pt,
      align=left,font=\small] (defense-card) at (2.25cm,0) {#2};
    \fill[defenseAccent]
      (defense-card.north west) rectangle ([xshift=2.2pt]defense-card.south west);
    \node[fill=defenseBoxHead,text=white,font=\footnotesize\bfseries,rounded corners=2.5pt,
      minimum width=2.05cm,inner ysep=3.8pt] at (1.025cm,0) {#1};
  \end{tikzpicture}\par\vspace{0.10cm}}

% Multi-column matrix card (2x2 or 3-column pillars): navy header bar + tint body.
\newcommand\DefenseGridCard[2]{%
  \par\noindent
  \begin{tikzpicture}
    \node[anchor=north west,text=white,font=\footnotesize\bfseries,
      inner xsep=6pt,inner ysep=3.2pt,text width=\linewidth-12pt-0.8pt,align=left]
      (defense-gcard-head) at (0,0) {#1};
    \node[anchor=north west,inner xsep=6pt,inner ysep=4.2pt,
      text width=\linewidth-12pt-0.8pt,align=left,font=\footnotesize]
      (defense-gcard-body) at (defense-gcard-head.south west) {#2};
    \begin{scope}[on background layer]
      \clip[rounded corners=2.5pt]
        (defense-gcard-head.north west) rectangle (defense-gcard-body.south east);
      \fill[defenseTint]
        (defense-gcard-head.north west) rectangle (defense-gcard-body.south east);
      \fill[defenseBoxHead]
        (defense-gcard-head.north west) rectangle (defense-gcard-head.south east);
    \end{scope}
    \draw[defenseLine,line width=0.5pt,rounded corners=2.5pt]
      (defense-gcard-head.north west) rectangle (defense-gcard-body.south east);
  \end{tikzpicture}\par}

% Key metric callout with thesis comparison basis: top navy rule + prominent value + muted basis.
\newcommand\DefenseKPI[3]{%
  \par\noindent
  \begin{tikzpicture}
    \node[anchor=north west,fill=defenseTint,inner xsep=6pt,inner ysep=3.5pt,
      text width=\linewidth-12pt-0.8pt,align=left] (defense-kpi) at (0,0) {%
      {\scriptsize\bfseries\color{defenseMuted}#1}\par\vspace{1pt}%
      {\normalsize\bfseries\color{defenseRed}#2}\par\vspace{1pt}%
      {\scriptsize\color{defenseMuted}#3}};
    \draw[defenseLine,line width=0.4pt]
      (defense-kpi.north west) rectangle (defense-kpi.south east);
    \fill[defenseNavy]
      (defense-kpi.north west) rectangle ([yshift=-2.2pt]defense-kpi.north east);
  \end{tikzpicture}\par}

% Speaker note of the frame, placed before \end{frame}. Only the presenter build
% (defense-notes.tex, second screen on the right) shows it.
% #1 key point, #2 script, #3 transition, #4 seconds.
\newcommand\DefenseNote[4]{%
  \note{\textbf{#1}\par\medskip
    #2\par\medskip
    {\color{gray}→ #3}\hfill{\scriptsize #4 秒}}}
\setbeamerfont{note page}{size=\small}
\setbeamertemplate{note page}[plain]

\endinput
