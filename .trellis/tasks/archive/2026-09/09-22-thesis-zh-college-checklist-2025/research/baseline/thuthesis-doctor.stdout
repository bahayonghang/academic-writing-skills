    {
      "id": "THU-01",
      "requirement": "论文题目\"严格控制在 25 个汉字（符）以内\"（指南无副题名合计条款，副题名一并计入 25 字判定）",
      "basis": "§2.3.1",
      "method": "script:title_len",
      "scope": "通用",
      "status": "PASS",
      "evidence": "题名 13 字: 面向虚构场景的占位研究方法"
    },
    {
      "id": "THU-02",
      "requirement": "中文摘要控制在 800～1000 汉字（符）",
