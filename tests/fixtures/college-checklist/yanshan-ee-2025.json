    "method": "llm",
    "scope": "通用",
    "status": {
      "doctor": "NEEDS-LLM",
      "master": "NEEDS-LLM"
    }
  },
  {
    "id": "YSE-012",
    "source_line": 165,
    "requirement": "「关键词：」在中文摘要正文下，黑体小四号顶格。；关键词 3～8 个，宋体小四号。；各关键词之间用分号隔开；换行时悬挂缩进对齐；最后一个关键词后不加标点。",
    "basis": "学院2025清单第12项",
    "method": "manual",
    "scope": "通用",
    "status": {
      "doctor": "MANUAL",
      "master": "MANUAL"
    }
  },
  {
    "id": "YSE-013",
    "source_line": 171,
    "requirement": "「分类号：」在关键词之下，黑体小四号顶格。；列 1～2 个中图分类号，宋体小四号；两号之间用分号；最后一个分类号后不加标点。",
    "basis": "学院2025清单第13项",
    "method": "manual",
    "scope": "通用",
    "status": {
